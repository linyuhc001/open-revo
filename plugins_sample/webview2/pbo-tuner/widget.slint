export component MainWindow inherits Window {
    title: "PBO 状态挂件 (Slint 原生)";
    width: 280px;
    height: 96px;
    background: #0f131a;
    default-font-size: 12px;

    in-out property <int> all_core_co: -10;
    in-out property <bool> pbo_active: true;
    in-out property <float> scalar: 1.0;
    in-out property <int> fmax_mhz: 0;

    Rectangle {
        border-radius: 10px;
        border-width: 1px;
        border-color: #a855f7;
        background: #0f131a;

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "PBO 精准调校";
                    font-size: 13px;
                    font-weight: 700;
                    color: #f1f5f9;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 18px;
                    border-radius: 4px;
                    background: root.pbo_active ? #7c3aed : #334155;

                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        Text {
                            text: root.pbo_active ? "PBO 生效" : "PBO 关闭";
                            font-size: 10px;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: space-between;

                Text {
                    text: "全核 CO: " + root.all_core_co + " mV";
                    font-size: 11.5px;
                    font-weight: 600;
                    color: root.all_core_co < 0 ? #34d399 : #f87171;
                    vertical-alignment: center;
                }

                Text {
                    text: "Scalar: " + round(root.scalar * 100) / 100 + "x";
                    font-size: 11.5px;
                    color: #cbd5e1;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.fmax_mhz > 0 ? "FMax: " + root.fmax_mhz + " MHz" : "FMax: 自动";
                font-size: 11px;
                color: #94a3b8;
                vertical-alignment: center;
            }
        }
    }
}
