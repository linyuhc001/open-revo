{
  "id": "battery-hardware-limit",
  "name": "电池充电上限守护者",
  "version": "2.4.0",
  "author": "OpenRevo Official & Community",
  "description": "官方演示插件：基于微内核硬件网关的原生三寄存器限充调控中心 (EC 0x07A6 保护模式 + 0x07B9 上限 + 0x07D0 回落下限)，与固件一致、零心跳、不触碰平台身份码，自由设定 1~100% 充电阈值。",
  "type": "tab",
  "min_host_version": "0.9.4",
  "window": {
    "width": 960,
    "height": 680,
    "resizable": true,
    "decorations": true,
    "transparent": false,
    "always_on_top": false
  },
  "telemetry": {
    "enabled": true,
    "sensors": [
      "battery_level",
      "is_charging",
      "is_ac_online",
      "is_dc_online",
      "battery_limit"
    ]
  },
  "config": {
    "default_mode": "native",
    "strategies": {
      "native_registers": {
        "name": "原生三寄存器模式 (Native Registers，现代固件推荐)",
        "protocol": "TongfangDirectEc",
        "limit_up_reg": 1977,
        "limit_down_reg": 2000,
        "mode_reg": 1958,
        "mode_station": 33,
        "mode_balance": 17,
        "mode_longlife": 1,
        "touchpad_bitmask": 8,
        "down_offset": 5
      },
      "generic_wmi": {
        "name": "通用 ACPI-WMI MULONG 邮箱通道",
        "protocol": "GenericAcpiWmi",
        "limit_reg": 1977,
        "storage_reg": 2175
      },
      "bld_mailbox": {
        "name": "宝龙达 WMI Mailbox 协议",
        "protocol": "BldWmiMailbox",
        "cmd_battery": 16,
        "subcmd_limit": 13,
        "subcmd_restore": 15
      }
    }
  }
}